    "lint": "eslint src --config eslint.config.js"
  },
  "devDependencies": {
    "@banana/config-eslint": "workspace:*",
    "@banana/config-typescript": "workspace:*",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3"
  }
