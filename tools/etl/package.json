{
  "name": "@banana/etl",
  "version": "0.1.0",
  "private": true,
  "description": "ETL reproducible de datos sintéticos para Banana Escolar (CSV → MySQL)",
  "scripts": {
    "generate": "tsx src/generate-data.ts",
    "run": "tsx src/cli.ts run",
    "verify": "tsx src/verify-cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --config eslint.config.mjs",
    "test": "jest --config jest.config.json --passWithNoTests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@banana/config-eslint": "workspace:*",
    "@banana/config-typescript": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
