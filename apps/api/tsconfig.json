{
  "extends": "@banana/config-typescript/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "sourceMap": true,
    "declaration": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts", "prisma/seed.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
