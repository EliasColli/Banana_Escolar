// Banana Escolar — esquema relacional MySQL 8.0+ / InnoDB / utf8mb4
// Ver docs/database/modelo-datos.md para el diccionario de datos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECNICO
  USUARIO
}

enum ReportStatus {
  pendiente
  en_proceso
  completado
}

enum Priority {
  baja
  media
  alta
}

model User {
  id            Int                @id @default(autoincrement())
  nombre        String             @db.VarChar(120)
  correo        String             @unique @db.VarChar(190)
  passwordHash  String             @map("password_hash") @db.VarChar(255)
  rol           Role
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now()) @map("creado_en") @db.DateTime(3)
  reportes      Report[]           @relation("ReportRequester")
  asignaciones  Report[]           @relation("ReportTechnician")
  soluciones    Solution[]
  adjuntos      ReportAttachment[]
  refreshTokens RefreshToken[]

  @@index([rol, activo], map: "idx_usuarios_rol_activo")
  @@map("usuarios")
}

model Category {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(100)
  reportes Report[]

  @@map("categorias")
}

model Report {
  id           Int                @id @default(autoincrement())
  folio        String             @unique @db.VarChar(20)
  usuarioId    Int                @map("usuario_id")
  categoriaId  Int                @map("categoria_id")
  tecnicoId    Int?               @map("tecnico_id")
  descripcion  String             @db.Text
  ubicacion    String             @db.VarChar(190)
  prioridad    Priority           @default(media)
  estado       ReportStatus       @default(pendiente)
  creadoEn     DateTime           @default(now()) @map("creado_en") @db.DateTime(3)
  asignadoEn   DateTime?          @map("asignado_en") @db.DateTime(3)
  usuario      User               @relation("ReportRequester", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoria    Category           @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tecnico      User?              @relation("ReportTechnician", fields: [tecnicoId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  solucion     Solution?
  adjuntos     ReportAttachment[]

  @@index([categoriaId, estado, creadoEn(sort: Desc), id(sort: Desc)], map: "idx_reportes_cat_estado_fecha")
  @@index([usuarioId, creadoEn(sort: Desc), id(sort: Desc)], map: "idx_reportes_usuario_fecha")
  @@index([tecnicoId, estado, creadoEn(sort: Desc)], map: "idx_reportes_tecnico_estado")
  @@index([estado, creadoEn(sort: Desc)], map: "idx_reportes_estado_fecha")
  @@index([ubicacion], map: "idx_reportes_ubicacion")
  @@fulltext([descripcion], map: "idx_reportes_descripcion_fulltext")
  @@map("reportes")
}

model Solution {
  id            Int      @id @default(autoincrement())
  reporteId     Int      @unique @map("reporte_id")
  tecnicoId     Int      @map("tecnico_id")
  descripcion   String   @db.Text
  observaciones String?  @db.Text
  resueltoEn    DateTime @default(now()) @map("resuelto_en") @db.DateTime(3)
  reporte       Report   @relation(fields: [reporteId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tecnico       User     @relation(fields: [tecnicoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tecnicoId, resueltoEn(sort: Desc)], map: "idx_soluciones_tecnico_fecha")
  @@map("soluciones")
}

model ReportAttachment {
  id         Int      @id @default(autoincrement())
  reporteId  Int      @map("reporte_id")
  storageKey String   @unique @map("storage_key") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(80)
  sizeBytes  Int      @map("size_bytes")
  uploadedBy Int      @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  reporte    Report   @relation(fields: [reporteId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reporteId], map: "idx_adjuntos_reporte")
  @@map("report_attachments")
}

model RefreshToken {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "idx_refresh_usuario")
  @@map("refresh_tokens")
}

model FolioCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("folio_counters")
}

model EtlRun {
  id           Int       @id @default(autoincrement())
  runId        String    @unique @map("run_id") @db.VarChar(64)
  startedAt    DateTime  @map("started_at") @db.DateTime(3)
  finishedAt   DateTime? @map("finished_at") @db.DateTime(3)
  sourceRows   Int       @map("source_rows")
  insertedRows Int       @map("inserted_rows")
  discardedRows Int      @map("discarded_rows")
  checksum     String    @db.Char(64)
  reportJson   Json      @map("report_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("etl_runs")
}
