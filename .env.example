# Plantilla de variables de entorno del monorepo.
# Copiar a apps/api/.env, apps/web/.env y tools/*/.env según se indique.
# NO versionar archivos .env reales ni secretos.

# --- apps/api ---
NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://banana_user:change_me@127.0.0.1:3306/banana_escolar"
JWT_ACCESS_SECRET=replace_with_strong_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_different_strong_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage/uploads
PUBLIC_APP_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Cookie de refresh para el cliente web (true en producción con HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- apps/web ---
VITE_API_URL=http://localhost:3000/v1

# --- tools/etl y tools/benchmark ---
# Reutilizan DATABASE_URL. El ETL escribe en la BD principal;
# el benchmark usa una BD de laboratorio separada.
BENCHMARK_DATABASE_URL="mysql://banana_user:change_me@127.0.0.1:3306/banana_benchmark"

# --- apps/mobile ---
# Se pasan con --dart-define, nunca como secretos:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/v1
